{
    "swagger": "2.0",
    "info": {
        "description": "This is a sample enrichment service.",
        "title": "Enrichment API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/enrichment": {
            "get": {
                "description": "Get address, pii and suggestions for a customer",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Enrich customer data",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Customer Code",
                        "name": "customer_code",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.EnrichmentResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.Address": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "number": {
                    "type": "string"
                },
                "state": {
                    "type": "string"
                },
                "street": {
                    "type": "string"
                }
            }
        },
        "models.EnrichmentResponse": {
            "type": "object",
            "properties": {
                "address": {
                    "$ref": "#/definitions/models.Address"
                },
                "metadata": {
                    "$ref": "#/definitions/models.Metadata"
                },
                "pii": {
                    "$ref": "#/definitions/models.Pii"
                },
                "suggestions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Suggestion"
                    }
                }
            }
        },
        "models.Metadata": {
            "type": "object",
            "properties": {
                "processing_time": {
                    "type": "string"
                }
            }
        },
        "models.Pii": {
            "type": "object",
            "properties": {
                "cpf": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "models.Suggestion": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "promotion": {
                    "type": "string"
                }
            }
        }
    }
}